set $media ~/dotfiles/bin/media-control

# Media controls
## Launch // Play / Pause // <◇> p ##
bindsym $mod+p exec $media toggle
## Launch // Prev Track // <◇> [ ##
bindsym $mod+bracketleft exec $media previous
## Launch // Next Track // <◇> ] ##
bindsym $mod+bracketright exec $media next

# Media keys
bindsym XF86AudioPlay exec $media toggle
bindsym XF86AudioPause exec $media toggle
bindsym XF86AudioNext exec $media next
bindsym XF86AudioPrev exec $media previous

# Volume contol
bindsym XF86AudioRaiseVolume exec pactl set-sink-volume @DEFAULT_SINK@ +5%
bindsym XF86AudioLowerVolume exec pactl set-sink-volume @DEFAULT_SINK@ -5%
bindsym XF86AudioMute exec pactl set-sink-mute @DEFAULT_SINK@ toggle
