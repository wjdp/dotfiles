#!/usr/bin/env python3
"""Pick a notification from mako's history with fuzzel and invoke its default action."""

import json
import subprocess
import sys

URGENCY_ICONS = {"low": "🔹", "normal": "💬", "critical": "🛑"}
BODY_LENGTH = 80


def one_line(text: str | None, length: int) -> str:
    text = (text or "").replace("\n", " ")
    return text if len(text) <= length else text[:length] + "…"


def history() -> list[dict]:
    output = subprocess.run(["makoctl", "history", "-j"], capture_output=True, text=True, check=True)
    return json.loads(output.stdout)


def render(notification: dict) -> str:
    icon = URGENCY_ICONS.get(notification.get("urgency"), "💬")
    body = one_line(notification.get("body"), BODY_LENGTH)
    summary = notification.get("summary") or ""
    return f"{icon} {notification.get('app_name') or 'Unknown'}: {summary}" + (f" — {body}" if body else "")


def main() -> None:
    notifications = history()
    if not notifications:
        subprocess.run(["notify-send", "-a", "mako", "No notifications in history"])
        return

    result = subprocess.run(
        ["fuzzel", "--dmenu", "--index", "--width", "80", "--prompt", "Notifications ❯ "],
        input="\n".join(render(n) for n in notifications),
        capture_output=True,
        text=True,
    )
    if result.returncode != 0 or not result.stdout.strip():
        sys.exit(1)

    chosen = notifications[int(result.stdout)]
    subprocess.run(["makoctl", "invoke", "-n", str(chosen["id"])])


if __name__ == "__main__":
    main()
