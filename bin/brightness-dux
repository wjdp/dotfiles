#!/bin/bash
# Usage: brightness-dux 50
# Sets brightness (VCP feature 10) on all detected DDC displays.
#
# ddcutil detect takes ~500ms, so the I2C bus numbers are cached. Bus numbers
# occasionally change; on any setvcp failure the cache is rebuilt and retried.
set -u

cache_file="${XDG_CACHE_HOME:-$HOME/.cache}/brightness-dux/buses"

detect_buses() {
	ddcutil detect --terse 2>/dev/null |
		grep -oP '/dev/i2c-\K[0-9]+'
}

write_cache() {
	mkdir -p "$(dirname "$cache_file")"
	printf '%s\n' "$@" >"$cache_file"
}

set_brightness() {
	local value=$1 pid rc=0
	shift
	local pids=()
	for bus in "$@"; do
		ddcutil --bus="$bus" setvcp 10 "$value" &
		pids+=($!)
	done
	for pid in "${pids[@]}"; do
		wait "$pid" || rc=1
	done
	return $rc
}

value=${1:?Usage: brightness-dux <0-100>}

buses=()
[ -f "$cache_file" ] && mapfile -t buses <"$cache_file"

if [ ${#buses[@]} -eq 0 ] || ! set_brightness "$value" "${buses[@]}"; then
	mapfile -t buses < <(detect_buses)
	[ ${#buses[@]} -eq 0 ] && {
		echo "brightness-dux: no DDC displays detected" >&2
		exit 1
	}
	write_cache "${buses[@]}"
	set_brightness "$value" "${buses[@]}"
fi
