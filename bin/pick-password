#!/usr/bin/env python3
"""Pick a pass entry with fuzzel and copy its password (or OTP) to the clipboard."""

import subprocess
import sys
from pathlib import Path

PASSWORD_STORE = Path("~/.password-store").expanduser()

MODES = {
    "pass": (["pass", "-c"], "Password ❯ "),
    "otp": (["pass", "otp", "-c"], "OTP ❯ "),
}


def password_names() -> list[str]:
    return sorted(
        str(path.relative_to(PASSWORD_STORE).with_suffix(""))
        for path in PASSWORD_STORE.glob("**/*.gpg")
    )


def pick(options: list[str], prompt: str) -> str | None:
    result = subprocess.run(
        ["fuzzel", "--dmenu", "--index", "--prompt", prompt],
        input="\n".join(options),
        capture_output=True,
        text=True,
    )
    if result.returncode != 0 or not result.stdout.strip():
        return None
    return options[int(result.stdout)]


def notify(message: str, urgency: str = "normal") -> None:
    subprocess.run(["notify-send", "-a", "pass", "-u", urgency, "pass", message])


def main() -> None:
    mode = sys.argv[1] if len(sys.argv) > 1 else "pass"
    if mode not in MODES:
        sys.exit(f"usage: {Path(sys.argv[0]).name} [{'|'.join(MODES)}]")
    command, prompt = MODES[mode]

    name = pick(password_names(), prompt)
    if name is None:
        sys.exit(1)

    if subprocess.run([*command, name], capture_output=True).returncode != 0:
        notify(f"Failed to copy {name}", urgency="critical")
        sys.exit(1)
    notify(f"{name} copied to clipboard")


if __name__ == "__main__":
    main()
